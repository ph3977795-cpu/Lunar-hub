local function ghostStartNoclip()
    if ghostNoclipEnabled then return end
    ghostNoclipEnabled = true
    table.clear(changedParts)
    ghostNoclipLoop = RunService.Stepped:Connect(function()
        if not ghostNoclipEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        ghostOverlapParams.FilterDescendantsInstances = {char, fakeModel, ghostPlatform}
        local parts = Workspace:GetPartBoundsInBox(root.CFrame, Vector3.new(4, 6, 4), ghostOverlapParams)
        for _, part in ipairs(parts) do
            if part:IsA("BasePart") and part.Parent and part ~= ghostPlatform and part.CanCollide then
                if changedParts[part] == nil then changedParts[part] = true end
                part.CanCollide = false
            end
        end
    end)
end

local function ghostStopNoclip()
    ghostNoclipEnabled = false
    if ghostNoclipLoop then ghostNoclipLoop:Disconnect() ghostNoclipLoop = nil end
    for part, _ in pairs(changedParts) do
        if part and part.Parent and part ~= ghostPlatform then part.CanCollide = true end
    end
    table.clear(changedParts)
end

local function ghostSetupFakeCharacter(model)
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    for _, state in ipairs({
        Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll,
        Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Climbing,
        Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Flying
    }) do
        pcall(function() humanoid:SetStateEnabled(state, false) end)
    end
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.Massless = true
        elseif obj:IsA("Script") or obj:IsA("LocalScript") then
            obj:Destroy()
        end
    end
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local animation = Instance.new("Animation")
    animation.Name = "LunarGhostWalk"
    animation.AnimationId = (humanoid.RigType == Enum.HumanoidRigType.R15)
        and GhostConfig.WalkAnimR15 or GhostConfig.WalkAnimR6
    local success, track = pcall(function() return animator:LoadAnimation(animation) end)
    if success and track then
        walkTrack = track
        walkTrack.Looped = true
        walkTrack.Priority = Enum.AnimationPriority.Movement
    end
    return true
end

local function ghostUpdateFakeAnimation(realHumanoid)
    if not walkTrack then return end
    local moving = realHumanoid.MoveDirection.Magnitude > 0.05
    if moving then
        if not walkTrack.IsPlaying then walkTrack:Play(0.12) end
        walkTrack:AdjustSpeed(math.clamp(realHumanoid.WalkSpeed / 16, 0.5, 2))
    else
        if walkTrack.IsPlaying then walkTrack:Stop(0.12) end
    end
end

local function ghostUpdateCameraAndGhost()
    if not isGhost or not fakeModel or not LocalPlayer.Character then return end
    local realChar = LocalPlayer.Character
    local realRoot = realChar:FindFirstChild("HumanoidRootPart")
    if not realRoot or not ghostPlatform then return end
    local fakeHumanoid = fakeModel:FindFirstChildOfClass("Humanoid")
    if fakeHumanoid and Camera.CameraSubject ~= fakeHumanoid then
        Camera.CameraSubject = fakeHumanoid
    end
    local currentPos = realRoot.Position
    realRoot.AssemblyLinearVelocity = Vector3.new(realRoot.AssemblyLinearVelocity.X, 0, realRoot.AssemblyLinearVelocity.Z)
    ghostPlatform.CFrame = CFrame.new(currentPos.X, targetY - GhostConfig.PlatformOffset, currentPos.Z)
    fakeModel:PivotTo(CFrame.new(currentPos.X, targetY + GhostConfig.Height, currentPos.Z) * realRoot.CFrame.Rotation)
    local realHumanoid = realChar:FindFirstChildOfClass("Humanoid")
    if realHumanoid then ghostUpdateFakeAnimation(realHumanoid) end
end

local function ghostStop()
    if not isGhost then return end
    isGhost = false
    GhostConfig.Enabled = false
    RunService:UnbindFromRenderStep("LunarGhostCameraFix")
    if camLockConnection then camLockConnection:Disconnect() camLockConnection = nil end
    ghostStopNoclip()
    if walkTrack then pcall(function() walkTrack:Stop(0.1) end) walkTrack = nil end
    local realChar = LocalPlayer.Character
    local realRoot = realChar and realChar:FindFirstChild("HumanoidRootPart")
    local realHumanoid = realChar and realChar:FindFirstChildOfClass("Humanoid")
    if realHumanoid then realHumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true) end
    if realRoot and fakeModel then
        local fakeRoot = fakeModel:FindFirstChild("HumanoidRootPart")
        if fakeRoot then realRoot.CFrame = fakeRoot.CFrame end
    end
    if realChar then
        for _, obj in ipairs(realChar:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Transparency = 0
                obj.CanTouch = true
                obj.CanQuery = true
                obj.CanCollide = true
            end
        end
        if realHumanoid then Camera.CameraSubject = realHumanoid end
    end
    if fakeModel then fakeModel:Destroy() fakeModel = nil end
    if ghostPlatform then ghostPlatform:Destroy() ghostPlatform = nil end
end

local function ghostStart()
    local realChar = LocalPlayer.Character
    if not realChar then return end
    local realRoot = realChar:FindFirstChild("HumanoidRootPart")
    local realHumanoid = realChar:FindFirstChildOfClass("Humanoid")
    if not realRoot or not realHumanoid then return end
    isGhost = true
    GhostConfig.Enabled = true
    realHumanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    local startCFrame = realRoot.CFrame
    targetY = startCFrame.Y - GhostConfig.Height
    ghostPlatform = Instance.new("Part")
    ghostPlatform.Name = "LunarGhostPlatform"
    ghostPlatform.Size = Vector3.new(10, 1, 10)
    ghostPlatform.Anchored = true
    ghostPlatform.CanCollide = true
    ghostPlatform.CanTouch = false
    ghostPlatform.CanQuery = false
    ghostPlatform.Transparency = 1
    ghostPlatform.Parent = Workspace
    realChar.Archivable = true
    for _, desc in ipairs(realChar:GetDescendants()) do desc.Archivable = true end
    local success, clonedChar = pcall(function() return realChar:Clone() end)
    if not success or not clonedChar then ghostStop() return end
    fakeModel = clonedChar
    fakeModel.Name = "LunarGhostVisual"
    for _, obj in ipairs(fakeModel:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript") then obj:Destroy() end
    end
    fakeModel.Parent = Workspace
    local fakeRoot = fakeModel:FindFirstChild("HumanoidRootPart")
    local fakeHumanoid = fakeModel:FindFirstChildOfClass("Humanoid")
    if not fakeRoot or not fakeHumanoid then ghostStop() return end
    fakeModel.PrimaryPart = fakeRoot
    if not ghostSetupFakeCharacter(fakeModel) then ghostStop() return end
    fakeModel:PivotTo(startCFrame)
    for _, obj in ipairs(realChar:GetDescendants()) do
        if obj:IsA("BasePart") then obj.Transparency = 1 end
    end
    ghostStartNoclip()
    realRoot.CFrame = CFrame.new(startCFrame.X, targetY, startCFrame.Z) * startCFrame.Rotation
    Camera.CameraSubject = fakeHumanoid
    camLockConnection = Camera:GetPropertyChangedSignal("CameraSubject"):Connect(function()
        if isGhost and fakeHumanoid and Camera.CameraSubject ~= fakeHumanoid then
            Camera.CameraSubject = fakeHumanoid
        end
    end)
    RunService:BindToRenderStep("LunarGhostCameraFix", Enum.RenderPriority.Last.Value, ghostUpdateCameraAndGhost)
end

