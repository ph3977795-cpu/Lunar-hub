local function godProtectCharacter(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function()
        origWalkSpeed = hum.WalkSpeed
        origJumpPower = hum.JumpPower
        origMaxHealth = hum.MaxHealth
    end)
    if GodConfig.AntiFallDamage then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)
    end
    if GodConfig.AntiFling then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function() hrp.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0) end)
        end
    end
    if GodConfig.ForceFieldClone then
        local existing = char:FindFirstChildOfClass("ForceField")
        if not existing then
            local ff = Instance.new("ForceField") ff.Visible = false ff.Parent = char
        end
    end
    if GodConfig.KeepMaxHealth then
        pcall(function()
            if hum.MaxHealth < 100000 then hum.MaxHealth = math.huge end
        end)
    end
end

local function godHealTick()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if GodConfig.InstaHeal then
        pcall(function()
            if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
        end)
    end
    if GodConfig.AntiFling then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                if hrp.AssemblyLinearVelocity.Magnitude > 200 then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end)
        end
    end
end

local function godLoop()
    while GodConfig.Enabled do
        godHealTick()
        if GodConfig.AntiBan then
            task.wait(GodConfig.AntiBanMinWait + math.random() * (GodConfig.AntiBanMaxWait - GodConfig.AntiBanMinWait))
        else
            RunService.Heartbeat:Wait()
        end
    end
end

local function godOnChar(char)
    godProtectCharacter(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        if GodConfig.HealthConn then GodConfig.HealthConn:Disconnect() end
        GodConfig.HealthConn = hum.HealthChanged:Connect(function(h)
            if not GodConfig.Enabled then return end
            if h < hum.MaxHealth then pcall(function() hum.Health = hum.MaxHealth end) end
        end)
    end
end

local function godStart()
    if GodConfig.Enabled then return end
    GodConfig.Enabled = true
    local char = LocalPlayer.Character
    if char then godOnChar(char) end
    GodConfig.CharConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        if GodConfig.Enabled then godOnChar(newChar) end
    end)
    GodConfig.GodThread = task.spawn(godLoop)
end

local function godStop()
    if not GodConfig.Enabled then return end
    GodConfig.Enabled = false
    if GodConfig.GodThread then task.cancel(GodConfig.GodThread) GodConfig.GodThread = nil end
    if GodConfig.CharConn then GodConfig.CharConn:Disconnect() GodConfig.CharConn = nil end
    if GodConfig.HealthConn then GodConfig.HealthConn:Disconnect() GodConfig.HealthConn = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.MaxHealth = origMaxHealth > 0 and origMaxHealth or 100
                hum.Health = math.min(hum.Health, hum.MaxHealth)
                hum.WalkSpeed = origWalkSpeed
                hum.JumpPower = origJumpPower
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            end)
        end
    end
end

