local function getRainbowColor()
    if not RainbowConfig.Enabled then return ESPConfig.Color end
    local hue = (tick() % RainbowConfig.Speed) / RainbowConfig.Speed
    return Color3.fromHSV(hue, RainbowConfig.Saturation, RainbowConfig.Value)
end

