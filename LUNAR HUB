local function drawBulletTrace(targetPos)
    if not RainbowConfig.BulletTrace or not hasDrawing then return end
    local trace = Drawing.new("Line")
    trace.Visible      = true
    trace.From         = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    trace.To           = Vector2.new(targetPos.X, targetPos.Y)
    trace.Thickness    = 2
    trace.Transparency = 1
    trace.Color        = getRainbowColor()
    table.insert(ActiveTraces, trace)

    task.spawn(function()
        local start = tick()
        while tick() - start < RainbowConfig.BulletLife do
            trace.Color        = getRainbowColor()
            trace.Transparency = 1 - ((tick() - start) / RainbowConfig.BulletLife)
            RunService.RenderStepped:Wait()
        end
        pcall(function() trace:Remove() end)
        for i, t in ipairs(ActiveTraces) do
            if t == trace then table.remove(ActiveTraces, i) break end
        end
    end)
end

