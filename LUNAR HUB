local OriginalPos = nil
local function toggleUI()
    if MainFrame.Visible then
        -- MINIMIZAR
        OriginalPos = MainFrame.Position
        MainFrame.Visible = false

        -- Coloca a minibar na posição horizontal central do painel
        MiniBar.Position = UDim2.new(
            OriginalPos.X.Scale,
            OriginalPos.X.Offset + (MainFrame.AbsoluteSize.X / 2 - 90),
            OriginalPos.Y.Scale,
            OriginalPos.Y.Offset
        )
        MiniBar.Visible = true
    else
        -- RESTAURAR
        MainFrame.Visible = true
        if OriginalPos then MainFrame.Position = OriginalPos end
        MiniBar.Visible = false
    end
end

